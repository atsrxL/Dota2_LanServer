# Trusted Bash configuration: review before sourcing as PVE root. No Steam passwords here.
CTID=270
CT_HOSTNAME="dota2-lan"
ROOTFS_STORAGE="local-lvm"     # Change to an existing storage with rootdir support, e.g. local-zfs
TEMPLATE_STORAGE="local"      # Storage supporting vztmpl
TEMPLATE="auto"               # Latest available official Ubuntu 24.04 amd64 template
BRIDGE="vmbr0"
IPV4="dhcp"                   # Or "192.168.1.70/24"
GATEWAY=""                    # Required for static IPv4; e.g. "192.168.1.1"
DNS=""                        # Empty: inherit PVE DNS; or e.g. "192.168.1.1"
VLAN_TAG=""                   # Empty for untagged; otherwise 1..4094
LAN_CIDRS="auto"              # Auto = CT eth0 IPv4 subnet; or "192.168.1.0/24,192.168.2.0/24"
# Prefer an explicit management CIDR when using VLANs. auto does not include other subnets.
PANEL_PORT=8080
GAME_PORT=27015
TIMEZONE="Asia/Tokyo"
SWAP_MIB=1024                  # Additional swap allowance, not RAM. Host must actually provide swap.
SSH_PUBLIC_KEY_FILE=""        # Normally unnecessary: use pct enter. Bootstrap does not install SSH.
STEAMCMD_ARCHIVE_SHA256=""     # Optional expected SHA-256 for the official mutable installer archive
# Fixed requested resources: 6 vCPU, 6144 MiB (6 GiB) RAM, rootfs storage:250.
